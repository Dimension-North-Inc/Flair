    "Quick Brown Fox": {
      "comment": "Font Preview Panagram",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Victor jagt zwölf Boxkämpfer quer über den großen Sylter Deich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quick brown fox jumps over a lazy dog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Benjamín pidió una bebida de kiwi y fresa; Noé, sin vergüenza, la más exquisita champaña del menú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buvez de ce whisky que le patron juge fameux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma la volpe, col suo balzo, ha raggiunto il quieto Fido."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pchnąć w tę łódź jeża lub ośm skrzyń fig."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жебракують філософи при ґанку церкви в Гадячі, ще й шатро їхнє п’яне знаємо."
          }
        }
      }
    },
    "Weight": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Breite:"
          }
        }
      }
    }
  },
  "version": "1.0"
